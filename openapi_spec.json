{
  "openapi": "3.1.0",
  "info": {
    "title": "Timi Stemi Risk Score API",
    "description": "Original TIMI STEMI clinical scoring endpoint and separate experimental audit endpoints.",
    "version": "4.0.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "Legacy experimental operations counters",
        "responses": {
          "200": {
            "description": "JSON counters, not Prometheus text"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Experimental generic audit processing (not TIMI STEMI scoring)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Air-gapped supervisory conversational assistant",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Retrieve and cryptographically verify HMAC audit trail",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/timi-stemi": {
      "post": {
        "summary": "Calculate original TIMI STEMI presentation-time score",
        "description": "Returns 0–14 points and historical 30-day all-cause mortality (InTIME II derivation cohort). Not a treatment rule.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "age": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 120
                  },
                  "diabetes_hypertension_angina": {
                    "type": "boolean"
                  },
                  "systolic_bp": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 400
                  },
                  "heart_rate": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 350
                  },
                  "killip_class": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "weight_kg": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 500
                  },
                  "anterior_st_elevation_or_lbbb": {
                    "type": "boolean"
                  },
                  "time_to_treatment_hours": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000
                  }
                },
                "required": [
                  "age",
                  "diabetes_hypertension_angina",
                  "systolic_bp",
                  "heart_rate",
                  "killip_class",
                  "weight_kg",
                  "anterior_st_elevation_or_lbbb",
                  "time_to_treatment_hours"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Risk score, point breakdown and original-cohort mortality estimate"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    }
  }
}
